# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connections
MONGO_URI=mongodb://localhost:27017/rideshare
MONGO_URI_TEST=mongodb://localhost:27017/rideshare_test

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Email Verification Service (Nodemailer Gmail SMTP)
# In development, if credentials are blank, OTP is safely logged to server console
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
